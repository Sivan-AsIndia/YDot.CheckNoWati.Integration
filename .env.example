# =================================================================================================
# YDot.Integration worker - secrets and per-machine settings.
#
# Copy this file to ".env" (same folder) and fill in the values. ".env" is git-ignored.
# The worker loads it at start-up; any variable already set in the environment wins.
# Keys use the .NET convention: Section__Key (double underscore) = setting Section:Key.
# =================================================================================================

# ---- Database: the SAME ydotphaseupdated database the YDot web application uses -----------------
# From the host (dotnet run / Visual Studio): the Docker PostgreSQL is published on port 6710.
# Inside the Docker network (docker compose): Host=ydot-postgres;Port=5432 (set by docker-compose.yml).
ConnectionStrings__IntegrationDatabase=Host=localhost;Port=6710;Database=ydotphaseupdated;Username=postgres;Password=user

# ---- CheckNumber.ai -------------------------------------------------------------------------------
CheckNumber__ApiKey=

# ---- WATI ------------------------------------------------------------------------------------------
Wati__TenantId=
Wati__ApiToken=
Wati__ChannelNumber=

# ---- Test safety (remove for production) -------------------------------------------------------------
# Only these numbers are ever messaged while this list is not empty (digits with country code).
# Wati__AllowedNumbers__0=919500873627
# Wati__AllowedNumbers__1=919841465676
# Wati__AllowedNumbers__2=919876543210
# At most this many messages per WATI job (0 = unlimited).
# Wati__MaxRecipientsPerJob=5

# ---- Optional ---------------------------------------------------------------------------------------
# Seq__ServerUrl=http://localhost:6711
# Pipeline__EnableWati=false
