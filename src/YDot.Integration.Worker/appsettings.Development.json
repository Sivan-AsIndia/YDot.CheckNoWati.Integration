{
  // Local development (dotnet run / Visual Studio). The content root is the project folder, so
  // "../../data" puts inbox/, files/, checknumber/, output/ at the SOLUTION root - the folder the
  // CAM container mounts when WHATSAPP_INTEGRATION_DATA points at it (see README).
  "Worker": {
    "DataRoot": "../../data",
    "InstanceName": "dev"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "YDot.Integration": "Debug"
      }
    }
  }
}
