{
  // ===============================================================================================
  // YDot.Integration worker - CheckNumber.ai + WATI.
  //
  // NOTHING SECRET LIVES IN THIS FILE. Put these in the .env file at the solution root (see
  // .env.example) or in the environment:
  //
  //   ConnectionStrings__IntegrationDatabase   the ydotphaseupdated PostgreSQL database
  //   CheckNumber__ApiKey                      CheckNumber.ai X-API-Key
  //   Wati__TenantId / Wati__ApiToken / Wati__ChannelNumber
  //
  // Every value below can be overridden the same way: Section__Key=value (double underscore).
  // ===============================================================================================

  "ConnectionStrings": {
    "IntegrationDatabase": ""
  },

  "Database": {
    // Create / upgrade the int_* tables on start-up (own history table: __ef_migrations_history_int).
    "ApplyMigrationsOnStartup": true,
    "CommandTimeoutSeconds": 60,
    // Keep retrying the database this long at start-up (Docker may start the worker first).
    "StartupConnectTimeoutSeconds": 120
  },

  "Worker": {
    // Blank = machine name. The process id is always appended, so two copies never share a lease.
    "InstanceName": "",
    // inbox/, files/, checknumber/, output/, rejected/ live here. In Docker: /app/data (shared with the CAM API).
    "DataRoot": "data",
    "ScanIntervalSeconds": 10,
    // A file copied in by hand is read only after its size/time stayed unchanged this long.
    "FileStabilitySeconds": 3,
    "MaxFileSizeMegabytes": 10,
    // Files dropped straight into the inbox (no web upload): organisation from inbox/{subdomain}/ or below.
    "AcceptFolderDrops": true,
    "DefaultTenantSubdomain": "",
    "MaxConcurrentJobs": 2,
    "JobLeaseSeconds": 300,
    "JobPollIntervalSeconds": 5,
    "CommandPollIntervalSeconds": 3,
    "HeartbeatIntervalSeconds": 30,
    "MaxConsecutiveStageFailures": 10
  },

  "Pipeline": {
    // Which stages run. Examples:
    //   only check numbers:            EnableCheckNumber=true,  EnableWati=false
    //   check, then message:           EnableCheckNumber=true,  EnableWati=true, AutoSendWati=true
    //   check now, message from page:  EnableCheckNumber=true,  EnableWati=true, AutoSendWati=false
    "EnableCheckNumber": true,
    "EnableWati": true,
    "AutoSendWati": true,
    "AllowManualWatiBroadcasts": true
  },

  "CheckNumber": {
    "BaseUrl": "https://api.checknumber.ai/",
    "ApiKey": "",
    // "ws" = WhatsApp number check, "ws_active" = WhatsApp activity check.
    "TaskType": "ws",
    "RequestTimeoutSeconds": 100,
    "InitialPollDelaySeconds": 30,
    "PollingIntervalSeconds": 30,
    "MaxPollingAttempts": 20,
    // 1.0 = fixed interval; e.g. 1.5 grows each wait up to MaxPollingIntervalSeconds.
    "PollingBackoffMultiplier": 1.0,
    "MaxPollingIntervalSeconds": 120,
    // CheckNumber.ai accepts small tasks but bills at least the price of 500 numbers per task.
    "MinimumNumbersPerTask": 1,
    "MaxNumbersPerTask": 50000,
    // true = one task per country (no "rewritten" foreign numbers, but a minimum charge per task).
    "SplitTasksByCountry": false,
    // Global = a saved Yes/No is reused for every organisation; Tenant = only for the one that paid.
    "ReuseScope": "Global",
    // 0 = a saved answer never expires.
    "ResultValidityDays": 0,
    // Used only for the estimate shown before a check; CheckNumber.ai bills actual_amount.
    "PricePerNumberUsd": 0.00009,
    "MinimumChargePerTaskUsd": 0.045,
    "DownloadTimeoutSeconds": 600,
    "MaxExtractedBytes": 209715200,
    "MaxArchiveEntries": 200
  },

  "Wati": {
    "BaseUrl": "https://live-mt-server.wati.io",
    "TenantId": "",
    "ApiToken": "",
    "ChannelNumber": "",
    "RequestTimeoutSeconds": 60,
    // 430 verified numbers -> batches of 100, 100, 100, 100, 30.
    "BatchSize": 100,
    "DelayBetweenBatchesMilliseconds": 1000,
    // Used when an upload does not name its own template / broadcast / parameters.
    "DefaultTemplateName": "l4l_001",
    "DefaultBroadcastName": "l4l_001",
    "DefaultParameters": [
      { "Name": "image_url", "Value": "https://stg.peoplesplanet.in/images/blind_stick_cam1.jpg" }
    ],
    // SAFETY CAP: at most this many messages per WATI job (0 = unlimited). Raise it on purpose for production.
    "MaxRecipientsPerJob": 5,
    // TEST MODE: when not empty, ONLY these numbers are ever messaged (digits with country code).
    "AllowedNumbers": [],
    // Never send the same template to the same number for the same campaign twice (0 days = ever).
    "SkipAlreadyMessagedNumbers": true,
    "DuplicateWindowDays": 0,
    "SendToUnverifiedNumbers": false,
    // After a timed-out send that WATI has no record of: false = mark failed (no risk of a duplicate).
    "ResendWhenDeliveryUnknown": false,
    "StatusSync": {
      "Enabled": true,
      "IntervalSeconds": 30,
      "FirstCheckAfterSeconds": 20,
      "CheckIntervalSeconds": 60,
      "MaxCheckIntervalMinutes": 30,
      "BatchSize": 50,
      "MaxTrackingHours": 72
    },
    "TemplateSync": {
      "Enabled": true,
      "IntervalMinutes": 60
    },
    // Offered on the Wati page while WATI's template list cannot be read; also supplies friendly
    // labels and default values for templates WATI does return.
    "Templates": [
      {
        "Name": "l4l_001",
        "Label": "L4L campaign appeal (image)",
        "Category": "MARKETING",
        "Body": "L4L campaign appeal with an image header ({{image_url}}). The approved wording is kept in WATI and replaces this text once the template list is synced.",
        "Parameters": [
          { "Name": "image_url", "Value": "https://stg.peoplesplanet.in/images/blind_stick_cam1.jpg" }
        ]
      }
    ]
  },

  "Retry": {
    // Retries after the first attempt, for transient failures only (408, 429, 5xx, timeouts):
    // 2, 4, 8 seconds with the defaults.
    "MaxAttempts": 3,
    "InitialDelaySeconds": 2,
    "MaxDelaySeconds": 60
  },

  "Output": {
    "WriteResultsCsv": true,
    "WriteSummaryJson": true
  },

  "Seq": {
    // e.g. http://localhost:6711 (the YDot stack's Seq). Blank = no Seq.
    "ServerUrl": ""
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}" }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/integration-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
